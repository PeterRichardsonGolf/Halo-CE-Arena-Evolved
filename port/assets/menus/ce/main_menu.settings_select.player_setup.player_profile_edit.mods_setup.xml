	<strings name="main_menu/settings_select/player_setup/player_profile_edit/mods_setup/help_strings">
		<string text=""/>
		<string text="The maps played: a mod's replace the stock maps\nit has. OK starts the game again with it."/>
		<string text="Off: landings never hurt in the campaign. Gametypes\nhave their own, in Arena Options."/>
		<string text="How health comes back in the campaign. Gametypes\nhave their own, in Arena Options."/>
		<string text="A clock of the time played on the level, in the\ncampaign's corner by the motion sensor."/>
		<string text="@15"/>
		<string text="On a wider screen, keep the HUD in a 16:9 or 4:3\npart at the middle; the view stays wide."/>
		<string text="With one player, draw split screen's smaller HUD:\nmeters, motion sensor and messages."/>
		<string text="How fast the scoreboard fades in and out while\nBack (or Tab) is held."/>
		<string text="Spoken power item spawns, in any gametype; with\nthe clock, Halo 1: NHE's talking timer too."/>
		<string text="@19"/>
		<string text="The callouts' voice: a folder of voices/, next\nto maps/."/>
		<string text="@22"/>
		<string text="Shorter game messages, as Halo 1: NHE's: a\nkilling spree reads Killing Spree!"/>
		<string text="@25"/>
		<string text="No clock in a multiplayer game's corner."/>
		<string text="Display the time remaining until the game ends."/>
		<string text="Display the time elapsed since the game started."/>
		<string text="Display the time remaining, with the time\nelapsed above it."/>
		<string text="One short line for the items spawning together,\nand the first one up. No beeps."/>
		<string text="Items spawning together in one line where the\nvoice has one, the item beep and five to one."/>
		<string text="Every item spawning together named, then each\none up in turn."/>
		<string text="TRAINING's spawn markers stay plain green."/>
		<string text="TRAINING's spawn markers glow where you would\nspawn next: hot is likely, dark red can't."/>
		<string text="TRAINING's spawn markers glow where the other\nteam would spawn next (in team games)."/>
		<string text="Each press of the zoom button zooms in a level,\nthen out, as Halo does."/>
		<string text="Zoomed while the button is held, to the first level\nonly: a second level is not reached."/>
		<string text="Tap to toggle, hold to zoom while held: a hold\nzooms to the first level, and letting go zooms out."/>
	</strings>
