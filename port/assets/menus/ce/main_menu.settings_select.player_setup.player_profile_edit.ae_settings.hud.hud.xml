	<strings name="main_menu/settings_select/player_setup/player_profile_edit/ae_settings/hud/hud/help_strings">
		<string text=""/>
		<string text="Pull the HUD in from the screen's edges, for\nTVs that cut the picture."/>
		<string text="With the multiplayer game timer on: words under\nthe clock, LEFT and PLAYED."/>
		<string text="A timer for your own camo or overshield."/>
		<string text="Medals you earn, shown in your view."/>
		<string text="With MEDALS on. UNIVERSAL: by your reticle.\nMCC: larger, on the left."/>
		<string text="Everyone's kills listed on your HUD, in place of\nthe game's kill messages."/>
		<string text="Team games: a cross where a teammate fell, until\nthey respawn."/>
		<string text="Players who left stay on the scoreboard, greyed."/>
		<string text="The color of the scoreboard's backing panel."/>
	</strings>
