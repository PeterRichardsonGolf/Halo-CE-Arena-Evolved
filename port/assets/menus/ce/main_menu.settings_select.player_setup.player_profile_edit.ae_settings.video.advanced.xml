	<strings name="main_menu/settings_select/player_setup/player_profile_edit/ae_settings/video/advanced/help_strings">
		<string text=""/>
		<string text="With HDR on: the picture's brightness."/>
		<string text="Precise depth far away, so close surfaces stop\nflickering. Takes effect after a restart."/>
		<string text="Keeps the graphics programs for next time, so\nfewer stalls. OFF builds them again each run."/>
		<string text="Skips drawing map parts the camera cannot see.\nOFF draws everything, as the console did."/>
		<string text="The graphics while two or more players share the\nscreen. AUTO plays at PERFORMANCE then."/>
		<string text="With split screen: lowers the 3D resolution when\nslower than this, and never limits frame rate.\nFRAME RATE LIMIT rises to match."/>
		<string text="How two players share the screen. AUTO goes\nSIDE BY SIDE on a 21:9 or wider screen."/>
		<string text="With TOP/BOTTOM: black bars at the sides give\neach view more height, at fewer pixels."/>
	</strings>
