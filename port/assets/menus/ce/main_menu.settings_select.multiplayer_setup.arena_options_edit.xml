	<strings name="main_menu/settings_select/multiplayer_setup/arena_options_edit/cap_arena_options">
		<string text="No time limit: the game ends only when someone\nreaches the score to win."/>
		<string text="The game ends after 1 minute, or sooner\nwhen someone reaches the score to win."/>
		<string text="The game ends after 2 minutes, or sooner\nwhen someone reaches the score to win."/>
		<string text="The game ends after 3 minutes, or sooner\nwhen someone reaches the score to win."/>
		<string text="The game ends after 4 minutes, or sooner\nwhen someone reaches the score to win."/>
		<string text="The game ends after 5 minutes, or sooner\nwhen someone reaches the score to win."/>
		<string text="The game ends after 6 minutes, or sooner\nwhen someone reaches the score to win."/>
		<string text="The game ends after 7 minutes, or sooner\nwhen someone reaches the score to win."/>
		<string text="The game ends after 8 minutes, or sooner\nwhen someone reaches the score to win."/>
		<string text="The game ends after 9 minutes, or sooner\nwhen someone reaches the score to win."/>
		<string text="The game ends after 10 minutes, or sooner\nwhen someone reaches the score to win."/>
		<string text="The game ends after 12 minutes, or sooner\nwhen someone reaches the score to win."/>
		<string text="The game ends after 15 minutes, or sooner\nwhen someone reaches the score to win."/>
		<string text="The game ends after 20 minutes, or sooner\nwhen someone reaches the score to win."/>
		<string text="The game ends after 25 minutes, or sooner\nwhen someone reaches the score to win."/>
		<string text="The game ends after 30 minutes, or sooner\nwhen someone reaches the score to win."/>
		<string text="The game ends after 45 minutes, or sooner\nwhen someone reaches the score to win."/>
		<string text="The game ends after 60 minutes, or sooner\nwhen someone reaches the score to win."/>
		<string text="A hard landing hurts, and a long enough fall kills."/>
		<string text="Landings never hurt, from any height. Pits and\nleaving the map still kill."/>
		<string text="Your health only comes back with a health pack."/>
		<string text="Once your shields are full, your health comes\nback to the top of the third it is in. Health\npacks fill the rest."/>
		<string text="Your shields are all that matter: your health\ncomes back as soon as they start to recharge."/>
		<string text="Once your shields are full, all your health\ncomes back."/>
		<string text="The pistol and sniper rifle spread as in stock Halo."/>
		<string text="The pistol's first shot from rest, and every\nunzoomed sniper rifle shot, go exactly where\nyou aim, as in Halo 1: NHE."/>
		<string text="Every pistol and sniper rifle shot goes exactly\nwhere you aim, held fire too: no spread and no\nbloom. Other weapons are unchanged."/>
		<string text="The game starts at once."/>
		<string text="A 3-2-1 countdown on a black screen starts the\ngame, so everyone sees the map at the same time."/>
		<string text="Weapons and powerups respawn as the map sets."/>
		<string text="Every weapon and powerup respawns every 30\nseconds, for practising grenade tricks."/>
		<string text="Halo 1: NHE's maps only: the vehicle set picks\nNHE's mode, as NHE did. On other maps the\ngametype's vehicles apply."/>
		<string text="On Halo 1: NHE's maps: no timers, as retail\nwith NHE's messages. On other maps the\ngametype's vehicles apply."/>
		<string text="On Halo 1: NHE's maps: NHE's talking and\non-screen timers. On other maps the\ngametype's vehicles apply."/>
		<string text="On Halo 1: NHE's maps: NHE's talking and\non-screen timers (its host teleport stays off:\nAE hosts neutrally). Other maps: the gametype's."/>
