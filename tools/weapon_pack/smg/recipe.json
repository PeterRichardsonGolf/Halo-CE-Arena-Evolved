  {"layer": "fix-xbox", "tag": "cmt/weapons/evolved/smg/smg.weapon", "op": "edit", "from": ["cmt", "cmt/weapons/evolved/smg/smg.weapon"], "edits": [["set", "model", "cmt/weapons/_shared/smg/smg.model"], ["set", "first_person_model", "cmt/weapons/_shared/smg/fp/fp.model"], ["set", "pickup_text_index", "4"], ["set", "hud_text_message_index", "0"]], "why": "the Xbox models; the pickup and HUD message indices the stock assault rifle's (CMT's point into CMT's own HUD texts)"},
